# Copy this file to .env:
#   cp .env.example .env
#
# No API key needed. This app uses a local model via Ollama
# (https://ollama.com) running on this machine — everything is free,
# offline, and never touches a credit balance.
#
# Before starting the server:
#   1. Install Ollama (https://ollama.com/download) if you haven't already
#   2. Make sure it's running: `ollama serve` (or just open the Ollama app)
#   3. Pull the model once:   `ollama pull gemma4:e2b`

# Optional overrides
PORT=3000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
MAX_UPLOAD_MB=25
